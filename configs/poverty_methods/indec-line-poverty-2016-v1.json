    "classification": "project_method_compatible_with_indec_line_poverty",
    "official_core": [
      "household adult-equivalent threshold construction",
      "CBA indigence line",
      "CBT poverty line",
      "household total-family-income comparison",
      "household status inherited by household members"
    ],
    "project_extensions": [
      "normalized FGT0/F​​GT1/FGT2 contributions",
      "positive monetary shortfall diagnostics"
    ]
  },
  "sources": [
    {
      "title": "INDEC Metodologia 22 - La medicion de la pobreza y la indigencia en la Argentina",
      "year": 2016,
      "url": "https://www.indec.gob.ar/ftp/cuadros/sociedad/EPH_metodologia_22_pobreza.pdf"
    },
    {
      "title": "INDEC Informa - Pobreza e ingresos",
      "year": 2026,
      "url": "https://www.indec.gob.ar/ftp/cuadros/publicaciones/indec_informa_04_26.pdf"
